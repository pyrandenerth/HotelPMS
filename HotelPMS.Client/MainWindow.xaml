<Window x:Class="HotelPMS.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HotelPMS.Client.ViewModels"
        Title="Hotel PMS — управление номерным фондом" Height="650" Width="1050"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="10,4"/></Style>
        <Style TargetType="TextBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="3"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Margin" Value="4"/></Style>
        <Style TargetType="DatePicker"><Setter Property="Margin" Value="4"/></Style>
        <Style TargetType="TextBlock"><Setter Property="Margin" Value="4"/></Style>
    </Window.Resources>

    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding StatusText}"/>
        </StatusBar>

        <TabControl Margin="6">

            <!-- ============ НОМЕРНОЙ ФОНД ============ -->
            <TabItem Header="Номерной фонд">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button Content="Обновить" Command="{Binding RefreshCommand}"/>
                        <TextBlock Text="Новый статус:" VerticalAlignment="Center"/>
                        <ComboBox Width="130" ItemsSource="{x:Static vm:MainViewModel.RoomStatuses}"
                                  SelectedItem="{Binding NewRoomStatus}"/>
                        <Button Content="Применить к выбранному номеру" Command="{Binding SetRoomStatusCommand}"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Номер" Binding="{Binding Number}"/>
                            <DataGridTextColumn Header="Этаж" Binding="{Binding Floor}"/>
                            <DataGridTextColumn Header="Категория" Binding="{Binding Type}"/>
                            <DataGridTextColumn Header="Цена/сут" Binding="{Binding BasePricePerNight}"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============ БРОНИРОВАНИЕ ============ -->
            <TabItem Header="Бронирование и заселение">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левая панель: гость и новая бронь -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <GroupBox Header="Новый гость">
                                <StackPanel>
                                    <TextBlock Text="ФИО"/><TextBox Text="{Binding GuestName, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Телефон"/><TextBox Text="{Binding GuestPhone}"/>
                                    <TextBlock Text="Паспорт"/><TextBox Text="{Binding GuestPassport}"/>
                                    <Button Content="Добавить гостя" Command="{Binding CreateGuestCommand}"/>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Новая бронь">
                                <StackPanel>
                                    <TextBlock Text="Гость"/>
                                    <ComboBox ItemsSource="{Binding Guests}" DisplayMemberPath="FullName"
                                              SelectedItem="{Binding BookingGuest}"/>
                                    <TextBlock Text="Заезд"/><DatePicker SelectedDate="{Binding CheckIn}"/>
                                    <TextBlock Text="Выезд"/><DatePicker SelectedDate="{Binding CheckOut}"/>
                                    <Button Content="Найти свободные номера" Command="{Binding FindRoomsCommand}"/>
                                    <ComboBox ItemsSource="{Binding AvailableRooms}" DisplayMemberPath="Display"
                                              SelectedItem="{Binding BookingRoom}"/>
                                    <Button Content="Забронировать" Command="{Binding CreateBookingCommand}"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Правая панель: список броней и действия -->
                    <DockPanel Grid.Column="1" Margin="6,0,0,0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                            <Button Content="Заселить" Command="{Binding CheckInCommand}"/>
                            <Button Content="Выселить" Command="{Binding CheckOutCommand}"/>
                            <Button Content="Отменить бронь" Command="{Binding CancelCommand}"/>
                        </StackPanel>

                        <GroupBox DockPanel.Dock="Bottom" Header="Счёт, услуги и оплата выбранной брони">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Услуга:"/>
                                    <ComboBox Width="190" ItemsSource="{Binding Services}" DisplayMemberPath="Display"
                                              SelectedItem="{Binding SelectedService}"/>
                                    <TextBlock Text="Кол-во:"/>
                                    <TextBox Width="40" Text="{Binding ServiceQty}"/>
                                    <Button Content="Добавить услугу" Command="{Binding AddServiceCommand}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Оплата:"/>
                                    <TextBox Width="80" Text="{Binding PayAmount}"/>
                                    <ComboBox Width="90" ItemsSource="{x:Static vm:MainViewModel.PaymentTypes}"
                                              SelectedItem="{Binding PayType}"/>
                                    <Button Content="Принять оплату" Command="{Binding PayCommand}"/>
                                </StackPanel>
                                <TextBlock FontWeight="SemiBold" DataContext="{Binding CurrentBill}">
                                    <Run Text="Ночей: "/><Run Text="{Binding Nights, Mode=OneWay}"/>
                                    <Run Text=" | Проживание: "/><Run Text="{Binding RoomCharge, Mode=OneWay}"/>
                                    <Run Text=" | Услуги: "/><Run Text="{Binding ServicesCharge, Mode=OneWay}"/>
                                    <Run Text=" | Итого: "/><Run Text="{Binding Total, Mode=OneWay}"/>
                                    <Run Text=" | Оплачено: "/><Run Text="{Binding Paid, Mode=OneWay}"/>
                                    <Run Text=" | К оплате: "/><Run Text="{Binding Balance, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </GroupBox>

                        <DataGrid ItemsSource="{Binding Bookings}" SelectedItem="{Binding SelectedBooking}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="№" Binding="{Binding Id}"/>
                                <DataGridTextColumn Header="Гость" Binding="{Binding Guest}" Width="*"/>
                                <DataGridTextColumn Header="Номер" Binding="{Binding Room}"/>
                                <DataGridTextColumn Header="Заезд" Binding="{Binding CheckInDate}"/>
                                <DataGridTextColumn Header="Выезд" Binding="{Binding CheckOutDate}"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ============ ОТЧЁТЫ ============ -->
            <TabItem Header="Финансовый анализ">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <TextBlock Text="С:" VerticalAlignment="Center"/>
                        <DatePicker SelectedDate="{Binding ReportFrom}"/>
                        <TextBlock Text="По (не включая):" VerticalAlignment="Center"/>
                        <DatePicker SelectedDate="{Binding ReportTo}"/>
                        <TextBlock Text="Год для таблицы:" VerticalAlignment="Center"/>
                        <TextBox Width="60" Text="{Binding Year}"/>
                        <Button Content="Сформировать" Command="{Binding LoadKpiCommand}"/>
                    </StackPanel>

                    <GroupBox DockPanel.Dock="Top" Header="Показатели за период">
                        <UniformGrid Columns="4" DataContext="{Binding Kpi}">
                            <TextBlock><Run Text="Загрузка (Occupancy), %: "/><Run Text="{Binding OccupancyRate, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                            <TextBlock><Run Text="ADR: "/><Run Text="{Binding Adr, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                            <TextBlock><Run Text="RevPAR: "/><Run Text="{Binding RevPar, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                            <TextBlock><Run Text="Общая выручка: "/><Run Text="{Binding TotalRevenue, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                            <TextBlock><Run Text="Выручка номеров: "/><Run Text="{Binding RoomRevenue, Mode=OneWay}"/></TextBlock>
                            <TextBlock><Run Text="Выручка услуг: "/><Run Text="{Binding ServicesRevenue, Mode=OneWay}"/></TextBlock>
                            <TextBlock><Run Text="Продано номеро-ночей: "/><Run Text="{Binding SoldRoomNights, Mode=OneWay}"/></TextBlock>
                            <TextBlock><Run Text="Доступно номеро-ночей: "/><Run Text="{Binding AvailableRoomNights, Mode=OneWay}"/></TextBlock>
                        </UniformGrid>
                    </GroupBox>

                    <GroupBox Header="Выручка от номеров по месяцам и категориям (график — следующий этап)">
                        <DataGrid ItemsSource="{Binding RevenueRows}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Месяц" Binding="{Binding Month}"/>
                                <DataGridTextColumn Header="Категория" Binding="{Binding RoomType}" Width="*"/>
                                <DataGridTextColumn Header="Выручка" Binding="{Binding RoomRevenue}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
